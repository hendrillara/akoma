        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "O Departamento Nacional de Defesa do Consumidor, da Secretaria Nacional de Direito Econômico (MJ), ou órgão federal que venha substituí-lo, é organismo de coordenação da política do Sistema Nacional de Defesa do Consumidor, cabendo-lhe:",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:fc2db294ed63ea682786d5f1945076350043ef2cc114fffb7caf4242cc55f700",
        "secondary": {
          "outcome": "agrees",
          "source": "camara-legin"
        }
      }
    },
    {
      "id": "art106_cpt_inc1",
      "norm": "cdc",
      "kind": "inciso",
      "label": "inciso I",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "artigo",
          "label": "Art. 106"
        },
        {
          "kind": "inciso",
          "label": "inciso I"
        }
      ],
      "text": "planejar, elaborar, propor, coordenar e executar a política nacional de proteção ao consumidor;",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:b115040ae6fb6931fba6ea35baf6cb81f798c820c119968f72b4462502b258ae",
        "secondary": {
          "outcome": "agrees",
          "source": "camara-legin"
        }
      }
    },
    {
      "id": "art106_cpt_inc2",
      "norm": "cdc",
      "kind": "inciso",
      "label": "inciso II",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "artigo",
          "label": "Art. 106"
        },
        {
          "kind": "inciso",
          "label": "inciso II"
        }
      ],
      "text": "receber, analisar, avaliar e encaminhar consultas, denúncias ou sugestões apresentadas por entidades representativas ou pessoas jurídicas de direito público ou privado;",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:9d6a67bb16937ca6d3a0da084f9229e167ba30286d5592220bc8b41b48abb17d",
        "secondary": {
          "outcome": "agrees",
          "source": "camara-legin"
        }
      }
    },
    {
      "id": "art106_cpt_inc3",
      "norm": "cdc",
      "kind": "inciso",
      "label": "inciso III",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "artigo",
          "label": "Art. 106"
        },
        {
          "kind": "inciso",
          "label": "inciso III"
        }
      ],
      "text": "prestar aos consumidores orientação permanente sobre seus direitos e garantias;",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
