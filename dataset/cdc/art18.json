        },
        {
          "kind": "inciso",
          "label": "inciso II"
        }
      ],
      "text": "os produtos deteriorados, alterados, adulterados, avariados, falsificados, corrompidos, fraudados, nocivos à vida ou à saúde, perigosos ou, ainda, aqueles em desacordo com as normas regulamentares de fabricação, distribuição ou apresentação;",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
