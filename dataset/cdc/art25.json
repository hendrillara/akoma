    {
      "id": "art25_par1",
      "norm": "cdc",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título I"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo IV"
