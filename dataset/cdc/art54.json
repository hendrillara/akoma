    {
      "id": "art54_par4",
      "norm": "cdc",
      "kind": "paragrafo",
      "label": "§ 4º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título I"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VI"
        },
