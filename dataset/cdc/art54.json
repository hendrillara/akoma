          "label": "Seção III"
        },
        {
          "kind": "artigo",
          "label": "Art. 54"
        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "Contrato de adesão é aquele cujas cláusulas tenham sido aprovadas pela autoridade competente ou estabelecidas unilateralmente pelo fornecedor de produtos ou serviços, sem que o consumidor possa discutir ou modificar substancialmente seu conteúdo.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:2df6d80c46a74a9e8ad392086fc7a4bb2c6f87ca54ca8ea6f46bd270dafd9746",
        "secondary": {
          "outcome": "agrees",
          "source": "camara-legin"
        }
      }
    },
    {
      "id": "art54_par1",
      "norm": "cdc",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título I"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VI"
        },
        {
          "kind": "secao",
          "label": "Seção III"
        },
        {
          "kind": "artigo",
          "label": "Art. 54"
        },
        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "A inserção de cláusula no formulário não desfigura a natureza de adesão do contrato.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:3b47b588106d307579caf2548971be0da15df4d82034edb27d8e75b7825b88df",
        "secondary": {
          "outcome": "agrees",
          "source": "camara-legin"
        }
      }
    },
    {
      "id": "art54_par2",
      "norm": "cdc",
      "kind": "paragrafo",
      "label": "§ 2º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título I"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VI"
        },
        {
          "kind": "secao",
          "label": "Seção III"
        },
        {
          "kind": "artigo",
          "label": "Art. 54"
        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "Nos contratos de adesão admite-se cláusula resolutória, desde que a alternativa, cabendo a escolha ao consumidor, ressalvando-se o disposto no § 2° do artigo anterior.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
