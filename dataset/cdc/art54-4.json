    "title": "Código de Defesa do Consumidor (Lei nº 8.078, de 11 de setembro de 1990)"
  },
  "article": "art54-4",
  "provisions": [
    {
      "id": "art54-4_cpt",
      "norm": "cdc",
      "kind": "caput",
      "label": "caput",
      "path": [
        {
          "kind": "titulo",
