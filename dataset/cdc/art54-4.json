        }
      }
    },
    {
      "id": "art54-4_cpt_inc3",
      "norm": "cdc",
      "kind": "inciso",
      "label": "inciso III",
      "path": [
        {
          "kind": "titulo",
          "label": "Título I"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VI-A"
        },
        {
          "kind": "artigo",
          "label": "Art. 54-D"
        },
        {
          "kind": "inciso",
          "label": "inciso III"
        }
      ],
      "text": "informar a identidade do agente financiador e entregar ao consumidor, ao garante e a outros coobrigados cópia do contrato de crédito.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "inserted",
          "annotation": "Incluído pela Lei nº 14.181, de 2021",
          "act": {
