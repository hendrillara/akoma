    {
      "id": "art54-2_par2",
      "norm": "cdc",
      "kind": "paragrafo",
      "label": "§ 2º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título I"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VI-A"
        },
        {
          "kind": "artigo",
          "label": "Art. 54-B"
        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "Para efeitos deste Código, o custo efetivo total da operação de crédito ao consumidor consistirá em taxa percentual anual e compreenderá todos os valores cobrados do consumidor, sem prejuízo do cálculo padronizado pela autoridade reguladora do sistema financeiro.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "inserted",
          "annotation": "Incluído pela Lei nº 14.181, de 2021",
          "act": {
            "citation": "Lei nº 14.181, de 2021",
            "type": "lei",
            "number": "14.181",
            "year": 2021,
            "href": "https://www.planalto.gov.br/ccivil_03/_Ato2019-2022/2021/Lei/L14181.htm#art1"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:0c948b0a1333b3032b7291e4858b0e8de5869e3156a871cc6af538804f51703e",
        "secondary": {
          "outcome": "agrees",
          "source": "camara-legin"
        }
      }
