    {
      "id": "art54-2_par1",
      "norm": "cdc",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título I"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VI-A"
        },
        {
          "kind": "artigo",
          "label": "Art. 54-B"
        },
        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "As informações referidas no art. 52 deste Código e no caput deste artigo devem constar de forma clara e resumida do próprio contrato, da fatura ou de instrumento apartado, de fácil acesso ao consumidor.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "inserted",
          "annotation": "Incluído pela Lei nº 14.181, de 2021",
          "act": {
            "citation": "Lei nº 14.181, de 2021",
            "type": "lei",
            "number": "14.181",
            "year": 2021,
            "href": "https://www.planalto.gov.br/ccivil_03/_Ato2019-2022/2021/Lei/L14181.htm#art1"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
        "retrievedAt": "2026-10-20",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:23f07cbe3b9c4020910e5895b81c752839a790ccb9f13abc8bb7267666f375c9",
        "secondary": {
