        {
          "kind": "artigo",
          "label": "Art. 6º"
        },
        {
          "kind": "inciso",
          "label": "inciso I"
        }
      ],
      "text": "a proteção da vida, saúde e segurança contra os riscos provocados por práticas no fornecimento de produtos e serviços considerados perigosos ou nocivos;",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
