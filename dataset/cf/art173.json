          "kind": "paragrafo",
          "label": "§ 3º"
        }
      ],
      "text": "A lei regulamentará as relações da empresa pública com o Estado e a sociedade.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
