        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "As empresas públicas e as sociedades de economia mista não poderão gozar de privilégios fiscais não extensivos às do setor privado.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
