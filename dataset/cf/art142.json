    {
      "id": "art142_cpt",
      "norm": "cf",
      "kind": "caput",
      "label": "caput",
      "path": [
        {
          "kind": "titulo",
          "label": "Título V"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo II"
        },
        {
          "kind": "artigo",
          "label": "Art. 142"
        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "As Forças Armadas, constituídas pela Marinha, pelo Exército e pela Aeronáutica, são instituições nacionais permanentes e regulares, organizadas com base na hierarquia e na disciplina, sob a autoridade suprema do Presidente da República, e destinam-se à defesa da Pátria, à garantia dos poderes constitucionais e, por iniciativa de qualquer destes, da lei e da ordem.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:da2726fad5b17e5aaab76cc3323893e5b4711c5591f8416131a323e0c9482793",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art142_par1",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título V"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo II"
        },
        {
          "kind": "artigo",
          "label": "Art. 142"
        },
        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "Lei complementar estabelecerá as normas gerais a serem adotadas na organização, no preparo e no emprego das Forças Armadas.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:2b6ced148f4b88dfd95838c7185e9d973d5656cbe89adf27b096509bd2d28295",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art142_par2",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 2º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título V"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo II"
        },
        {
          "kind": "artigo",
          "label": "Art. 142"
        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "Não caberá habeas corpus em relação a punições disciplinares militares.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
