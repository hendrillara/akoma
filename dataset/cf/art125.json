        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art125_par6",
      "aliases": [
        "art125_par6,emc-45-2004-12-08"
      ],
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 6º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo III"
        },
        {
          "kind": "secao",
          "label": "Seção VIII"
        },
        {
          "kind": "artigo",
          "label": "Art. 125"
        },
        {
          "kind": "paragrafo",
          "label": "§ 6º"
        }
      ],
      "text": "O Tribunal de Justiça poderá funcionar descentralizadamente, constituindo Câmaras regionais, a fim de assegurar o pleno acesso do jurisdicionado à justiça em todas as fases do processo.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "inserted",
          "annotation": "Incluído pela Emenda Constitucional nº 45, de 2004",
          "act": {
