    {
      "id": "art220_par3_inc2",
      "norm": "cf",
      "kind": "inciso",
      "label": "inciso II",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo V"
