    {
      "id": "art220_cpt",
      "norm": "cf",
      "kind": "caput",
      "label": "caput",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo V"
        },
        {
          "kind": "artigo",
          "label": "Art. 220"
        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "A manifestação do pensamento, a criação, a expressão e a informação, sob qualquer forma, processo ou veículo não sofrerão qualquer restrição, observado o disposto nesta Constituição.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
