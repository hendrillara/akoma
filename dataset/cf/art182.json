        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "A política de desenvolvimento urbano, executada pelo Poder Público municipal, conforme diretrizes gerais fixadas em lei, tem por objetivo ordenar o pleno desenvolvimento das funções sociais da cidade e garantir o bem- estar de seus habitantes.",
      "status": "in_force",
      "amendments": [],
      "references": [
        {
          "kind": "regulamento",
          "annotation": "Regulamento",
          "href": "https://www.planalto.gov.br/ccivil_03/LEIS/LEIS_2001/L10257.htm"
        },
        {
          "kind": "act",
          "annotation": "Vide Lei nº 13.311, de 11 de julho de 2016",
          "act": {
            "citation": "Lei nº 13.311, de 11 de julho de 2016",
            "type": "lei",
            "number": "13.311",
            "href": "https://www.planalto.gov.br/ccivil_03/_Ato2015-2018/2016/Lei/L13311.htm"
          }
        }
      ],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
