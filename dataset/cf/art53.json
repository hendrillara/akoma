        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "Os Deputados e Senadores são invioláveis, civil e penalmente, por quaisquer de suas opiniões, palavras e votos.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "wording",
          "annotation": "Redação dada pela Emenda Constitucional nº 35, de 2001",
