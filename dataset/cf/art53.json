    {
      "id": "art53_par1",
      "aliases": [
        "art53_par1,emc-35-2001-12-20"
      ],
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo I"
        },
        {
          "kind": "secao",
          "label": "Seção V"
        },
        {
          "kind": "artigo",
          "label": "Art. 53"
        },
        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "Os Deputados e Senadores, desde a expedição do diploma, serão submetidos a julgamento perante o Supremo Tribunal Federal.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "wording",
          "annotation": "Redação dada pela Emenda Constitucional nº 35, de 2001",
          "act": {
            "citation": "Emenda Constitucional nº 35, de 2001",
            "type": "emenda_constitucional",
            "number": "35",
            "year": 2001,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc35.htm#art1"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:7e391b1256f69ae8c5ed2fe0972094f30e6ea554e479fc5f5def26ba8db47d23",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art53_par2",
      "aliases": [
        "art53_par1"
      ],
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 2º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo I"
        },
        {
          "kind": "secao",
          "label": "Seção V"
        },
        {
          "kind": "artigo",
          "label": "Art. 53"
        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "Desde a expedição do diploma, os membros do Congresso Nacional não poderão ser presos, salvo em flagrante de crime inafiançável. Nesse caso, os autos serão remetidos dentro de vinte e quatro horas à Casa respectiva, para que, pelo voto da maioria de seus membros, resolva sobre a prisão.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "wording",
          "annotation": "Redação dada pela Emenda Constitucional nº 35, de 2001",
          "act": {
            "citation": "Emenda Constitucional nº 35, de 2001",
            "type": "emenda_constitucional",
            "number": "35",
            "year": 2001,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc35.htm#art1"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:c455a523a4bf5fd73fa4267cbc43b27c71b41e2e7c90b4b9318e7d5bb9cb8dcc",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
