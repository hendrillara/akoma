          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art66_par4",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 4º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo I"
