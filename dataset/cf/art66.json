          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art66_par1",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo I"
