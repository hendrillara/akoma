    {
      "id": "art66_par3",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 3º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo I"
        },
        {
          "kind": "secao",
          "label": "Seção VIII"
