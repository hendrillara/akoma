        {
          "kind": "artigo",
          "label": "Art. 66"
        },
        {
          "kind": "paragrafo",
          "label": "§ 3º"
        }
      ],
      "text": "Decorrido o prazo de quinze dias, o silêncio do Presidente da República importará sanção.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
