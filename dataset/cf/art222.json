    },
    {
      "id": "art222_par1",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo V"
        },
        {
          "kind": "artigo",
          "label": "Art. 222"
        },
        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "Em qualquer caso, pelo menos setenta por cento do capital total e do capital votante das empresas jornalísticas e de radiodifusão sonora e de sons e imagens deverá pertencer, direta ou indiretamente, a brasileiros natos ou naturalizados há mais de dez anos, que exercerão obrigatoriamente a gestão das atividades e estabelecerão o conteúdo da programação.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "wording",
          "annotation": "Redação dada pela Emenda Constitucional nº 36, de 2002",
          "act": {
            "citation": "Emenda Constitucional nº 36, de 2002",
            "type": "emenda_constitucional",
            "number": "36",
            "year": 2002,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc36.htm#art1"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:fdc369b056c9247ef0b1b587b5eb1f6bd63ca232fd48fabc7993360c23cd5538",
        "secondary": {
          "outcome": "agrees",
