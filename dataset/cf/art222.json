        }
      }
    },
    {
      "id": "art222_par2",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 2º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo V"
        },
        {
          "kind": "artigo",
          "label": "Art. 222"
        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "A responsabilidade editorial e as atividades de seleção e direção da programação veiculada são privativas de brasileiros natos ou naturalizados há mais de dez anos, em qualquer meio de comunicação social.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "wording",
          "annotation": "Redação dada pela Emenda Constitucional nº 36, de 2002",
          "act": {
            "citation": "Emenda Constitucional nº 36, de 2002",
            "type": "emenda_constitucional",
            "number": "36",
            "year": 2002,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc36.htm#art1"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:9c72fb2bd608fd7b398e96100bf5fb92e11573be935027e0fed4bc7cf1113c4a",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
