    {
      "id": "art222_cpt",
      "norm": "cf",
      "kind": "caput",
      "label": "caput",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo V"
        },
        {
          "kind": "artigo",
          "label": "Art. 222"
        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "A propriedade de empresa jornalística e de radiodifusão sonora e de sons e imagens é privativa de brasileiros natos ou naturalizados há mais de dez anos, ou de pessoas jurídicas constituídas sob as leis brasileiras e que tenham sede no País.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "wording",
          "annotation": "Redação dada pela Emenda Constitucional nº 36, de 2002",
          "act": {
            "citation": "Emenda Constitucional nº 36, de 2002",
            "type": "emenda_constitucional",
            "number": "36",
            "year": 2002,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc36.htm#art1"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:bd87fa555fbff2976a1434490a00897d85849be36ea041bfdf169885d963b9db",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
