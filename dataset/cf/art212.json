    {
      "id": "art212_cpt",
      "norm": "cf",
      "kind": "caput",
      "label": "caput",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo III"
