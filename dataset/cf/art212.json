    },
    {
      "id": "art212_par4",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 4º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo III"
        },
        {
          "kind": "secao",
          "label": "Seção I"
        },
        {
          "kind": "artigo",
          "label": "Art. 212"
        },
        {
          "kind": "paragrafo",
          "label": "§ 4º"
        }
      ],
      "text": "Os programas suplementares de alimentação e assistência à saúde previstos no art. 208, VII, serão financiados com recursos provenientes de contribuições sociais e outros recursos orçamentários.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:854f7843b3ca684a1ec883bd5c6eceb9b435bda440322ed2174675e60e627aba",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art212_par5",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 5º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo III"
        },
        {
          "kind": "secao",
          "label": "Seção I"
        },
        {
          "kind": "artigo",
          "label": "Art. 212"
        },
        {
          "kind": "paragrafo",
          "label": "§ 5º"
        }
      ],
      "text": "A educação básica pública terá como fonte adicional de financiamento a contribuição social do salário-educação, recolhida pelas empresas na forma da lei.",
      "status": "in_force",
