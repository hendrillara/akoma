        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "Cada Estado e o Distrito Federal elegerão três Senadores, com mandato de oito anos.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
