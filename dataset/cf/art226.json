        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:1554928c7342b80172532bdbb24e1b83d92a1f9e5549cd6620f3edd50947fe3b",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art226_par8",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 8º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 8º"
        }
      ],
      "text": "O Estado assegurará a assistência à família na pessoa de cada um dos que a integram, criando mecanismos para coibir a violência no âmbito de suas relações.",
      "status": "in_force",
      "amendments": [],
