        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "A família, base da sociedade, tem especial proteção do Estado.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
