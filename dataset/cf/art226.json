    {
      "id": "art226_par7",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 7º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 7º"
        }
      ],
      "text": "Fundado nos princípios da dignidade da pessoa humana e da paternidade responsável, o planejamento familiar é livre decisão do casal, competindo ao Estado propiciar recursos educacionais e científicos para o exercício desse direito, vedada qualquer forma coercitiva por parte de instituições oficiais ou privadas.",
      "status": "in_force",
      "amendments": [],
      "references": [
        {
          "kind": "regulamento",
          "annotation": "Regulamento",
          "href": "https://www.planalto.gov.br/ccivil_03/LEIS/L9263.htm"
        }
      ],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
