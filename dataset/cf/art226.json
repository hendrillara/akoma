          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art226_par1",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "O casamento é civil e gratuita a celebração.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:bcb3141b3e859139049f1c0b00bdfe87ad89dd91f7ec23d71ed476ec767fc4af",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art226_par2",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 2º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "O casamento religioso tem efeito civil, nos termos da lei.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:f5bb935b0eda29b537273840c27d09a0c25fa4e8b1957d1d5b5f5c14fe8109bf",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art226_par3",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 3º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 3º"
        }
      ],
      "text": "Para efeito da proteção do Estado, é reconhecida a união estável entre o homem e a mulher como entidade familiar, devendo a lei facilitar sua conversão em casamento.",
      "status": "in_force",
      "amendments": [],
      "references": [
        {
          "kind": "regulamento",
          "annotation": "Regulamento",
          "href": "https://www.planalto.gov.br/ccivil_03/LEIS/L9278.htm"
        }
      ],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:261bfd3fd1f8d10e70d5277075da904db5dbebee67409147ce584e39509758a3",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art226_par4",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 4º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 4º"
        }
      ],
      "text": "Entende-se, também, como entidade familiar a comunidade formada por qualquer dos pais e seus descendentes.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:00afe25aa022c179e006c50ee8729c15f2a2f835a193b0121b30ab371b9dc410",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art226_par5",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 5º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 5º"
        }
      ],
      "text": "Os direitos e deveres referentes à sociedade conjugal são exercidos igualmente pelo homem e pela mulher.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:b03e0b59ab77cbdd8b7d8684b16d543bb907effb213bea730f24ba6c42b8d41c",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art226_par6",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 6º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo VII"
        },
        {
          "kind": "artigo",
          "label": "Art. 226"
        },
        {
          "kind": "paragrafo",
          "label": "§ 6º"
        }
      ],
      "text": "O casamento civil pode ser dissolvido pelo divórcio.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "wording",
          "annotation": "Redação dada Pela Emenda Constitucional nº 66, de 2010",
