        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
      }
    },
    {
      "id": "art215_par1",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
