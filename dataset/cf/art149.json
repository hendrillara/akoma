          "kind": "artigo",
          "label": "Art. 149"
        },
        {
          "kind": "paragrafo",
          "label": "§ 1º-A"
        }
      ],
      "text": "Quando houver deficit atuarial, a contribuição ordinária dos aposentados e pensionistas poderá incidir sobre o valor dos proventos de aposentadoria e de pensões que supere o salário-mínimo.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "inserted",
          "annotation": "Incluído pela Emenda Constitucional nº 103, de 2019",
          "act": {
            "citation": "Emenda Constitucional nº 103, de 2019",
            "type": "emenda_constitucional",
            "number": "103",
            "year": 2019,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc103.htm#art1"
          }
        }
      ],
      "references": [
        {
          "kind": "vigencia",
          "annotation": "Vigência",
          "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc103.htm#art36ii"
        }
      ],
      "provenance": {
