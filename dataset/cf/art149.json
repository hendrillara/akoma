    },
    {
      "id": "art149_par1-1",
      "aliases": [
        "art149_par1-1,emc-103-2019-11-12"
      ],
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º-A",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VI"
