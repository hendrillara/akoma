    {
      "id": "art149_cpt",
      "norm": "cf",
      "kind": "caput",
      "label": "caput",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VI"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo I"
