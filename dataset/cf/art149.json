    {
      "id": "art149_par1-2",
      "aliases": [
        "art149_par1-2,emc-103-2019-11-12"
      ],
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º-B",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VI"
