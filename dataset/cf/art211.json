    {
      "id": "art211_par1",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VIII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo III"
