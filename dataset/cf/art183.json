        {
          "kind": "artigo",
          "label": "Art. 183"
        },
        {
          "kind": "paragrafo",
          "label": "§ 2º"
        }
      ],
      "text": "Esse direito não será reconhecido ao mesmo possuidor mais de uma vez.",
      "status": "in_force",
      "amendments": [],
      "references": [],
      "provenance": {
