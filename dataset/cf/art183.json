    },
    {
      "id": "art183_par1",
      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 1º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título VII"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo II"
