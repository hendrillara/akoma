      "norm": "cf",
      "kind": "paragrafo",
      "label": "§ 4º",
      "path": [
        {
          "kind": "titulo",
          "label": "Título IV"
        },
        {
          "kind": "capitulo",
          "label": "Capítulo II"
        },
        {
          "kind": "secao",
          "label": "Seção III"
