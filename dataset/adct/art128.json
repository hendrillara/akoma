        {
          "kind": "paragrafo",
          "label": "§ 1º"
        }
      ],
      "text": "Os benefícios ou os incentivos fiscais ou financeiros relativos aos impostos previstos nos arts. 155, II, e 156, III, da Constituição Federal não alcançados pelo disposto no caput deste artigo serão reduzidos na mesma proporção.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "inserted",
          "annotation": "Incluído pela Emenda Constitucional nº 132, de 2023",
          "act": {
            "citation": "Emenda Constitucional nº 132, de 2023",
            "type": "emenda_constitucional",
            "number": "132",
            "year": 2023,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc132.htm#art2"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:f0c8aee84691f2e3f70d2555a3058db25220d497c5271d6d1f7bef651b1b1bf3",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
