        },
        {
          "kind": "caput",
          "label": "caput"
        }
      ],
      "text": "Fica reconhecido, no ano de 2022, o estado de emergência decorrente da elevação extraordinária e imprevisível dos preços do petróleo, combustíveis e seus derivados e dos impactos sociais dela decorrentes.",
      "status": "in_force",
      "amendments": [
        {
          "effect": "inserted",
          "annotation": "Incluído pela Emenda Constitucional nº 123, de 2022",
          "act": {
            "citation": "Emenda Constitucional nº 123, de 2022",
            "type": "emenda_constitucional",
            "number": "123",
            "year": 2022,
            "href": "https://www.planalto.gov.br/ccivil_03/constituicao/Emendas/Emc/emc123.htm#art2"
          }
        }
      ],
      "references": [],
      "provenance": {
        "sourceUrl": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicaocompilado.htm",
        "retrievedAt": "2026-10-21T01:26:39Z",
        "datasetVersion": "2026-10-21",
        "notice": "Texto não oficial: confira a fonte. A vigência não é verificada contra decisões do STF. / Unofficial text: check the source. Vigência is not verified against STF decisions.",
        "contentHash": "sha256:ea78a611816eefc988d82f080849a18cd684e5c12a050c06bbab8eca385ef105",
        "secondary": {
          "outcome": "agrees",
          "source": "normas.leg.br"
        }
